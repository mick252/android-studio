<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#59CA59"
    tools:context=".MainActivity4">

    <TextView
        android:id="@+id/textView4"
        android:layout_width="355dp"
        android:layout_height="133dp"
        android:text="Uw bladje is besteld!"
        android:textSize="50sp"
        tools:layout_editor_absoluteX="28dp"
        tools:layout_editor_absoluteY="34dp" />

    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="299dp"
        android:layout_height="231dp"
        app:srcCompat="@drawable/bladdje_part_3_1"
        tools:layout_editor_absoluteX="56dp"
        tools:layout_editor_absoluteY="181dp" />

    <TextView
        android:id="@+id/textView8"
        android:layout_width="233dp"
        android:layout_height="117dp"
        android:text="(24 uur wachtijd)"
        android:textSize="45sp"
        tools:layout_editor_absoluteX="89dp"
        tools:layout_editor_absoluteY="435dp" />

    <Button
        android:id="@+id/button4"
        android:layout_width="189dp"
        android:layout_height="88dp"
        android:backgroundTint="#147E16"
        android:text="Bestel nog een blaadje!"
        android:textSize="20sp"
        tools:layout_editor_absoluteX="111dp"
        tools:layout_editor_absoluteY="610dp" />
</androidx.constraintlayout.widget.ConstraintLayout>